# Copy to .env — NEVER commit .env. All secrets live here / in your host's env, never in the frontend.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-admin-key
CORS_ORIGIN=https://empty-trackload.onrender.com
DATA_FILE=./data/db.json
COMMISSION_MIN=3
COMMISSION_MAX=10
COMMISSION_DEFAULT=5

# Paystack (https://dashboard.paystack.com) — keep the SECRET key server-side only.
# Leave blank to run in simulation mode (escrow endpoints fall back to demo behavior).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://loadmatch.example.com/dashboard.html
